---
layout: null
---
[
{% assign photo_files = site.static_files | sort: "relative_path" %}
{% assign first_photo = true %}
{% for file in photo_files %}
  {% assign source_path_parts = file.relative_path | split: "photos/" %}
  {% if source_path_parts.size > 1 %}
    {% assign photo_path = source_path_parts.last | prepend: "photos/" %}
    {% assign relative_photo_path = photo_path | remove_first: "photos/" %}
    {% assign path_parts = relative_photo_path | split: "/" %}
    {% assign filename_parts = path_parts.last | split: "." %}
    {% assign extension = filename_parts.last | downcase %}
    {% if path_parts.size == 3 %}
      {% if extension == "jpg" or extension == "jpeg" or extension == "png" or extension == "webp" or extension == "gif" %}
        {% unless first_photo %},{% endunless %}
        {"path":{{ photo_path | jsonify }},"set":{{ path_parts[0] | jsonify }},"description":{{ path_parts[1] | jsonify }}}
        {% assign first_photo = false %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endfor %}
]
